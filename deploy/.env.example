# ---- Copie para .env e preencha. Nunca versione o .env. ----

# E-mail para o Let's Encrypt (avisos de certificado).
ACME_EMAIL=infra@easyos.com.br

# Domínio do painel central da EasyOS (cadastro dos clientes).
PLATFORM_HOST=admin.easyos.com.br
MultiTenancy__PlatformHosts__0=admin.easyos.com.br

# Primeiro usuário do painel: usado só se o catálogo estiver vazio. Remova após o primeiro acesso.
Platform__BootstrapAdmin__Email=
Platform__BootstrapAdmin__Password=

# Fuso em que o legado gravava created_date/last_update (App Service do Azure = UTC).
App__StorageTimeZone=UTC

# Arquivos (Downloads, logos, assinaturas): Cloudflare R2 ou Backblaze B2 (S3-compatível).
# R2: ServiceUrl=https://<account-id>.r2.cloudflarestorage.com  Region=auto
# B2: ServiceUrl=https://s3.<regiao>.backblazeb2.com             Region=<regiao>
Storage__Provider=S3
Storage__ServiceUrl=
Storage__Region=auto
Storage__Bucket=easyos-files
Storage__AccessKey=
Storage__SecretKey=

# SMTP padrão (usado quando o cliente não tem SMTP próprio cadastrado no painel).
Email__DefaultSmtp__Host=
Email__DefaultSmtp__Port=587
Email__DefaultSmtp__EnableSsl=true
Email__DefaultSmtp__UserName=
Email__DefaultSmtp__Password=
Email__DefaultSmtp__FromAddress=
Email__DefaultSmtp__FromName=EasyOS

# Geocodificação de endereços de clientes. Sem chave, usa o OpenStreetMap (Nominatim), gratuito.
Geocoding__GoogleApiKey=

# Tentativas de login por minuto, por IP e domínio.
Security__LoginAttemptsPerMinute=10
