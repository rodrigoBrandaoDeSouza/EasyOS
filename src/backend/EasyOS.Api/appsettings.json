{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Catalog": "Data Source=data/catalog.db"
  },
  "DataProtection": {
    "KeysPath": "data/keys"
  },
  "App": {
    "StorageTimeZone": "UTC"
  },
  "MultiTenancy": {
    "TenantDatabaseProvider": "SqlServer",
    "PlatformHosts": [ "admin.easyos.com.br" ],
    "HostOverrides": {}
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "data/storage",
    "ServiceUrl": null,
    "Region": "auto",
    "Bucket": null,
    "AccessKey": null,
    "SecretKey": null
  },
  "Email": {
    "DefaultSmtp": {
      "Host": null,
      "Port": 587,
      "EnableSsl": true,
      "UserName": null,
      "Password": null,
      "FromAddress": null,
      "FromName": "EasyOS"
    }
  },
  "Platform": {
    "BootstrapAdmin": {
      "Email": null,
      "Password": null
    }
  }
}
